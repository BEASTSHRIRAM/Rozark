# Rozark environment — copy to .env and fill in the one required key:
#   cp .env.example .env
#
# Docker Compose reads this file (backend `env_file`), and the local-dev
# path can too:  export $(grep -v '^#' .env | xargs)  before uvicorn.

# === THE ONE KEY YOU MUST ADD ===
# Groq API key for the in-sandbox coding agent / agent proxy. Get a free
# key at groq.com. Without it the platform still runs (auth, challenges,
# sandbox, scoring); only live agent calls fail.
GROQ_API_KEY=

# Optional: Groq model for the agent proxy.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative provider: an Anthropic API key is used only when
# GROQ_API_KEY is not set. ROZARK_AI_API_KEY, if set, takes precedence
# over ANTHROPIC_API_KEY for the agent proxy (e.g. a budget-capped key).
ANTHROPIC_API_KEY=
ROZARK_AI_API_KEY=

# Model the agent proxy uses with the Anthropic provider.
ROZARK_AI_MODEL=claude-sonnet-4-5

# JWT signing secret for auth sessions. The backend reads exactly this
# name (backend/app/auth.py). Change it in any real deployment.
ROZARK_JWT_SECRET=change-me-in-production

# Sandbox backend: "local" = local-process sandbox (real PTY, real
# recording; works with no Docker). Use "docker" on hosts that have
# Docker for per-session container isolation.
ROZARK_SANDBOX_BACKEND=local

# Frontend -> backend base URL (browser-side).
NEXT_PUBLIC_API_URL=http://localhost:8000
